# ==============================================================================
# FICHIER D'ENVIRONNEMENT DE PRODUCTION POUR HETZNER CLOUD
# Copiez ce fichier sous le nom .env sur votre serveur : cp .env.production.example .env
# ==============================================================================

# Mot de passe sécurisé pour l'utilisateur root de MySQL
MYSQL_ROOT_PASSWORD=VotreMotDePasseMySQLUltraSecurise2026!

# Clé secrète pour signer les jetons d'authentification JWT (64 caractères conseillés)
JWT_SECRET=generer_une_cle_secrete_aleatoire_tres_longue_pour_accessorio_2026

# Domaine autorisé pour CORS (ou '*' si vous utilisez le proxy Nginx inclus)
CORS_ORIGIN=*
