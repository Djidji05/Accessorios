# ==============================================================================
# FICHIER D'ENVIRONNEMENT DE PRODUCTION POUR HETZNER CLOUD
# Copiez ce fichier sous le nom .env sur votre serveur : cp .env.production.example .env
# ==============================================================================

# Mot de passe sécurisé pour l'utilisateur root de MySQL
MYSQL_ROOT_PASSWORD=VotreMotDePasseMySQLUltraSecurise2026!

# Clé secrète pour signer les jetons d'authentification JWT (64 caractères conseillés)
JWT_SECRET=generer_une_cle_secrete_aleatoire_tres_longue_pour_accessorio_2026

# Domaine autorisé pour CORS (ou '*' si vous utilisez le proxy Nginx inclus)
CORS_ORIGIN=*

# ==============================================================================
# CONFIGURATION RESEND (RECOMMANDÉ POUR PRODUCTION)
# 1. Créez un compte gratuit sur https://resend.com
# 2. Générez une clé API dans "API Keys" (ex: re_123456789_abcdef...)
# 3. Ajoutez et vérifiez votre domaine dans "Domains" (ou utilisez onboarding@resend.dev pour tester)
# ==============================================================================
RESEND_API_KEY=re_votre_cle_api_resend_ici
RESEND_FROM="D'Alexis Transferencia <notifications@votredomaine.com>"

# Destinataires d'administration pour les alertes d'escalade SLA (> 30 min, 60 min...)
ADMIN_NOTIFICATION_EMAILS=admin@votredomaine.com,direction@votredomaine.com

# ==============================================================================
# ALTERNATIVE : SMTP CLASSIQUE (Non nécessaire si RESEND_API_KEY est renseigné)
# ==============================================================================
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_votre_cle_api_resend_ici
# SMTP_FROM="D'Alexis Transferencia <notifications@votredomaine.com>"
