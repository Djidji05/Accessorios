# URL de Connexion MySQL (avec pool de 30 connexions pour montée en charge)
# Format: mysql://UTILISATEUR:MOT_DE_PASSE@HOST:PORT/NOM_DE_LA_BASE?connection_limit=30
DATABASE_URL="mysql://root:password@localhost:3306/accessorio_db?connection_limit=30&pool_timeout=15"

# Port du serveur Express
PORT=4000

# Clé secrète JWT cryptographique (Générez une clé aléatoire forte en production, ex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="remplacez_par_une_cle_secrete_aleatoire_de_64_caracteres_hex"

# Domaine autorisé CORS (Front-end Vite)
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Configuration Email Resend (Recommandé en production - utilise HTTPS port 443)
RESEND_API_KEY="re_votre_cle_api_resend_ici"
RESEND_FROM="D'Alexis Transferencia <notifications@votredomaine.com>"

# Alternative : Configuration SMTP (Gmail, Hostinger, ou relais smtp.resend.com)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="resend"
SMTP_PASS="re_votre_cle_api_resend_ici"
SMTP_FROM="D'Alexis Transferencia <notifications@votredomaine.com>"

# Destinataires d'administration pour les alertes d'escalade SLA (> 30 min, 60 min...)
ADMIN_NOTIFICATION_EMAILS="admin@accessorio.com,supervision@accessorio.com"

