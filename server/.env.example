# URL de Connexion MySQL (avec pool de 30 connexions pour montée en charge)
# Format: mysql://UTILISATEUR:MOT_DE_PASSE@HOST:PORT/NOM_DE_LA_BASE?connection_limit=30
DATABASE_URL="mysql://root:password@localhost:3306/accessorio_db?connection_limit=30&pool_timeout=15"

# Port du serveur Express
PORT=4000

# Clé secrète JWT
JWT_SECRET="dalexis_transferencia_super_secret_jwt_key_2026"

# Domaine autorisé CORS (Front-end Vite)
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Configuration SMTP pour envoi des Emails (Gmail, Mailgun, SendGrid, Hostinger...)
# Pour Gmail, utilisez un mot de passe d'application 16 caractères (App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@dalexistransferencia.com"
SMTP_PASS="mot_de_passe_ou_app_password"
SMTP_FROM="D'Alexis Transferencia <notifications@dalexistransferencia.com>"

# Destinataires d'administration pour les alertes d'escalade SLA (> 30 min, 60 min...)
ADMIN_NOTIFICATION_EMAILS="admin@accessorio.com,supervision@accessorio.com"
